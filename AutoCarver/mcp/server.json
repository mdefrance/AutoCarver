{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.mdefrance/autocarver",
  "description": "Qualify dataset columns and process them against a target with AutoCarver, fully on your machine.",
  "version": "7.6.3",
  "websiteUrl": "https://autocarver.readthedocs.io/en/latest/mcp.html",
  "repository": {
    "url": "https://github.com/mdefrance/AutoCarver",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "autocarver",
      "version": "7.6.3",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "python",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "AutoCarver.mcp"
        }
      ]
    },
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "autocarver",
      "version": "7.6.3",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uv",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "run"
        },
        {
          "type": "positional",
          "value": "python"
        },
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "AutoCarver.mcp"
        }
      ]
    }
  ]
}
